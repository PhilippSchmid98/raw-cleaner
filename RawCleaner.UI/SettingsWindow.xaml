<ui:FluentWindow
    x:Class="RawCleaner.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="Einstellungen – RawCleaner"
    Width="580"
    MinWidth="460"
    Height="520"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Title Bar ─────────────────────────────────────────── -->
        <ui:TitleBar Grid.Row="0" Title="Einstellungen" />

        <!-- ─── Content ───────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,16">

                <!-- ── RAW file extensions ─────────────────────────── -->
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock
                            Text="RAW-Dateierweiterungen"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Margin="0,0,0,6" />
                        <TextBlock
                            Text="Kommagetrennte Liste (z. B.  .raf, .cr3, .nef, .arw)"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8" />
                        <ui:TextBox
                            Text="{Binding RawExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText=".raf, .cr3, .nef, .arw, .dng, …" />
                    </StackPanel>
                </ui:Card>

                <!-- ── RAW subfolder candidates ────────────────────── -->
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock
                            Text="RAW-Unterordner-Kandidaten"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Margin="0,0,0,6" />
                        <TextBlock
                            Text="Ordnernamen, die beim Auto-Erkennen des RAW-Ordners geprüft werden (erster Treffer gewinnt)"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8" />
                        <ui:TextBox
                            Text="{Binding RawFolderCandidatesText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="RAW, Raw, raw, Raws, …" />
                    </StackPanel>
                </ui:Card>

                <!-- ── Default move subfolder ──────────────────────── -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock
                            Text="Standard-Unterordner für RAW-Verschiebung"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Margin="0,0,0,6" />
                        <TextBlock
                            Text="Wird als Standardziel beim Sortieren gemischter Ordner vorgeschlagen"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8" />
                        <ui:TextBox
                            Text="{Binding DefaultRawSubfolderName, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="RAW" />
                    </StackPanel>
                </ui:Card>

                <!-- ── Action buttons ──────────────────────────────── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button
                        Content="Zurücksetzen"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        Command="{Binding ResetCommand}"
                        Margin="0,0,8,0" />
                    <ui:Button
                        Content="Speichern"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Save24}"
                        Command="{Binding SaveCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
