using System.Configuration;
using System.Data;
using System.Windows;
using RawCleaner.Core.Services;
using RawCleaner.UI.ViewModels;

namespace RawCleaner.UI
{
    /// <summary>
    /// Interaction logic for App.xaml
    /// </summary>
    public partial class App : Application
    {
        protected override void OnStartup(StartupEventArgs e)
        {
            base.OnStartup(e);

            // Manual DI – no container required for this size of app
            var syncService = new PhotoSyncService();
            var viewModel = new MainViewModel(syncService);

            // If launched from the Explorer context menu, pre-fill the folder path
            // (the registered command passes the selected folder as argv[1])
            if (e.Args.Length > 0 && Directory.Exists(e.Args[0]))
                viewModel.RawFolderPath = e.Args[0];

            var window = new MainWindow(viewModel);
            window.Show();
        }
    }
